APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost
# Railway / production: set APP_URL to your public https URL; logs:
# LOG_CHANNEL=stderr

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# 3307 = bundled local mysqld (scripts/start-local-mysql.sh). Use 3306 for a normal install.
DB_PORT=3307
# One-time: php artisan db:bootstrap-local --import   (or run database/setup/homestead-local.sql as MySQL root)
# DB_ROOT_PASSWORD=
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret
# Local-only fallback if you cannot create `homestead`: use a user that already connects (never in production)
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_root_password
#
# --- Railway ---
# On your Laravel/web service (not on the MySQL service), add variables — preferably references, not pasted secrets:
#   DATABASE_URL=${{MySQL.MYSQL_URL}}
#     Use the variable picker; prefix must match your MySQL service name (e.g. MySQL, mysql-myproject).
#     MYSQL_URL uses host mysql.railway.internal — correct for app + DB in the same Railway project.
#   MYSQL_PUBLIC_URL = only for DBeaver/local tools outside Railway (viaduct.proxy.rlwy.net), not for the app.
# If you use DATABASE_URL, you do not need DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD.
# Also set: APP_ENV=production, APP_DEBUG=false, APP_KEY= (php artisan key:generate --show),
# APP_URL=https://YOUR-SERVICE.up.railway.app, LOG_CHANNEL=stderr
# Networking: generate a public domain on the Laravel service.
# If credentials were ever shared, rotate them in Railway (MySQL service → Data → reset/regenerate).

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
# MAIL_HOST=mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=info@rentsuit.com
MAIL_PASSWORD=Rentasuit8
MAIL_ENCRYPTION=tls
MAIL_FROM=info@rentsuit.com
MAIL_FROM_NAME="Rent A Suit"

# Email confirmation on registration (true/false)
CONFIRM_EMAIL=true

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

UPS_ACCESS_KEY=
UPS_USER_ID=
UPS_PASSWORD=
UPS_SANDBOX=

PAYPAL_SANDBOX_API_USERNAME=
PAYPAL_SANDBOX_API_PASSWORD=
PAYPAL_SANDBOX_API_SECRET=

PAYPAL_API_USERNAME=
PAYPAL_API_PASSWORD=
PAYPAL_API_SECRET=
